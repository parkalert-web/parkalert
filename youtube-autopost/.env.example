# Copiez ce fichier en « .env » (dans youtube-autopost/) pour les essais en local.
# ⚠ .env est ignoré par git : ces valeurs ne doivent JAMAIS être publiées.
# En production, les mêmes clés se saisissent dans GitHub → Settings → Secrets
# and variables → Actions.

YT_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
YT_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
YT_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx

# Uniquement si config.json utilise "source": "drive"
# (l'identifiant se lit dans l'URL du dossier Drive, après /folders/)
YT_DRIVE_FOLDER_ID=
